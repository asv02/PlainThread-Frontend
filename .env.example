# Public (browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SITE_URL=https://plainthread.in

# Server only — never commit real values
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMIN_PASSWORD=
# Required on Vercel. Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Plain Thread <hello@plainthread.in>"
ORDER_NOTIFY_EMAIL=hello@plainthread.in

# Commerce
SHIPPING_RUPEES=0
# Extra COD fee in paise. 0 = no COD surcharge (Magic Checkout still offers COD).
COD_FEE_PAISE=0
# Magic Checkout dashboard URLs (public, no auth):
#   /api/razorpay/shipping-info
#   /api/razorpay/promotions
#   /api/razorpay/promotions/apply
# Webhook extra events: payment.pending, order.placed
STOCK_HOLD_MINUTES=2
NEXT_PUBLIC_GST_RATE_PERCENT=5
GST_RATE_PERCENT=5
NEXT_PUBLIC_GST_INCLUSIVE=false
GST_INCLUSIVE=false
GST_ORIGIN_STATE=Haryana

# Local only. Never true on Vercel/production.
ALLOW_SIMULATED_PAYMENTS=false

# debug | info | error. Default: debug in development, info in production.
LOG_LEVEL=info
